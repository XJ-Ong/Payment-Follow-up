DATABASE_URL=postgresql+psycopg2://followup:followup_dev_password@localhost:5432/followup
AI_MODE=template

# Backend only. Obtain from @BotFather; never expose through VITE_* variables.
TELEGRAM_BOT_TOKEN=
# Manual smoke test only; production recipients come from approved customer mappings.
TELEGRAM_TEST_CHAT_ID=

VITE_API_URL=http://localhost:8000
# Set to demo only for the standalone frontend preview
VITE_DATA_MODE=api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Demo mode: enables the X-Role/X-User-Id header simulation (NOT real authentication).
# Fail-to-secure: leave unset or false on any shared/public deployment.
DEMO_MODE=true
# Requests per client IP per minute; 0 disables the limiter.
RATE_LIMIT_PER_MINUTE=1200

# Mock approved leave scenarios; restart the backend after changing these.
DEMO_FINANCE_LEAVE=false
DEMO_OWNER_LEAVE=false

# Scheduler (optional, defaults to disabled). Restart the backend after changing these.
ENABLE_SCHEDULER=false  # Set to 'true' to enable automated jobs
DAILY_CHECK_HOUR=9  # Hour (0-23) for daily scoring refresh (MYT)
ENABLE_WEEKLY_SUMMARY=false  # Set to 'true' to enable weekly summary job
WEEKLY_SUMMARY_DAY=monday  # Day for weekly summary (monday-sunday)
WEEKLY_SUMMARY_HOUR=9  # Hour (0-23) for weekly summary (MYT)
